# Appwrite (database + storage)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=mun_dashboard
APPWRITE_BUCKET_TOPIC_GUIDES=topic_guides
APPWRITE_BUCKET_INSTAGRAM_POSTS=instagram_posts

# Auth — signs the session cookie AND doubles as the shared team password.
# Any length; padded internally for cookie signing.
#
# Sec-Gen access is NOT a password: it's a property of each account, granted in
# the Sec-Gen Panel. While no Sec-Gen account exists, signing in with this
# password grants owner rights so you can create the first accounts. Once one
# exists it drops to member-level, and it can be switched off entirely from the
# Sec-Gen Panel → Accounts & access.
SESSION_PASSWORD=change-me-to-a-long-random-string

# Public base URL of the app — used to build account invite links and links
# Apps Script / Meta fetch. MUST be correct in production or emailed invite
# links will point at the wrong host.
# Local: http://localhost:3000   Production: your Render URL.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google Apps Script (see SETUP.md). Powers Classroom posts, invite emails,
# minutes Docs, and generated topic-guide Docs.
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXX/exec
CLASSROOM_COURSE_ID=123456789

# Cron endpoints (/api/classroom/cron, /api/reminders/cron) send email and post
# to Classroom, so they reject unauthorized callers. Set this to any random
# string in production; server.js presents it automatically. Left unset, the
# routes accept loopback requests only, which is fine for local development.
CRON_SECRET=

# Instagram (optional — only needed for auto-post, see SETUP.md)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# OpenAI (optional — powers the AI half of the Topic Bank's "Suggest topics".
# If unset, suggestions fall back to the curated seed list silently.)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
